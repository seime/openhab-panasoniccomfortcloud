<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.openhab.addons.bundles</groupId>
    <artifactId>org.openhab.addons.reactor.bundles</artifactId>
    <version>4.0.0</version>
  </parent>

  <version>4.1.0-SNAPSHOT</version>

  <artifactId>no.seime.openhab.binding.panasoniccomfortcloud</artifactId>

  <name>Seime Add-ons :: Bundles :: Panasonic Comfort Cloud Binding</name>

  <properties>
    <!-- Optional dependencies of the embedded jsoup (re2j is only used when enabled via system property) -->
    <bnd.importpackage>com.google.re2j.*;resolution:=optional,org.jspecify.annotations.*;resolution:=optional</bnd.importpackage>
  </properties>

  <repositories>
    <repository>
      <id>openhab-release</id>
      <url>https://openhab.jfrog.io/artifactory/libs-release</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
    <repository>
      <id>openhab-snapshot</id>
      <url>https://openhab.jfrog.io/artifactory/libs-snapshot</url>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>
  <dependencies>
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.24.1</version>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>standalone</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openhab.tools.sat</groupId>
            <artifactId>sat-plugin</artifactId>
            <configuration>
              <checkstyleFilter>checkstyle-suppressions.xml</checkstyleFilter>
              <checkstyleProperties>ruleset.properties</checkstyleProperties>
              <spotbugsExclude>spotbugs-suppressions.xml</spotbugsExclude>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.commonjava.maven.plugins</groupId>
            <artifactId>directory-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>directories</id>
                <phase>none</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>oh3</id>
      <activation>
        <activeByDefault>false</activeByDefault>
      </activation>
    </profile>
    <profile>
      <!-- Replace the SNAPSHOT qualifier in Bundle-Version with a UTC build timestamp (e.g. 4.1.0.202611231545),
        matching openHAB snapshot bundles. The GitHub release workflow names versioned releases after it, so users can
        map `bundle:list` output to a release. The Maven version / jar file name is unaffected.
        Disabled with -Doh3: the openHAB 3.x parent has no oh.bndDefaults property, so the OH3 compatibility build
        must keep the parent's bnd configuration. -->
      <id>bundle-timestamp</id>
      <activation>
        <property>
          <name>!oh3</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>biz.aQute.bnd</groupId>
            <artifactId>bnd-maven-plugin</artifactId>
            <configuration>
              <bnd><![CDATA[${oh.bndDefaults}
-snapshot: ${tstamp;yyyyMMddHHmm;UTC}]]></bnd>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

  </profiles>
</project>
