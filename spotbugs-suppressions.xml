<?xml version="1.0" encoding="UTF-8"?>
<!-- Generic rules from openhab-addons tools/static-code-analysis/spotbugs/suppressions.xml -->
<FindBugsFilter>
  <!-- Excludes all bugs with priority higher than 4 -->
  <Match>
    <Rank value="4"/>
    <Not>
      <Bug pattern="SLF4J_LOGGER_SHOULD_BE_NON_STATIC"/>
    </Not>
  </Match>
  <!-- This pattern is not wanted as it reports usage of Throwable.getMessage() as argument to SLF4J logger -->
  <Match>
    <Bug pattern="SLF4J_MANUALLY_PROVIDED_MESSAGE"/>
  </Match>
  <Match>
    <Bug pattern="SLF4J_UNKNOWN_ARRAY"/>
  </Match>
  <Match>
    <Bug pattern="SLF4J_SIGN_ONLY_FORMAT"/>
  </Match>
  <Match>
    <!-- see https://github.com/spotbugs/spotbugs/issues/1992 -->
    <Bug pattern="SA_LOCAL_SELF_COMPARISON"/>
  </Match>
</FindBugsFilter>
